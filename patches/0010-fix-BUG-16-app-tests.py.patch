test_search_is_case_insensitive_for_cyrillic сверялся с текстом в нижнем регистре;
test_static_pages ожидал 200 для /staff/, хотя раздел требует входа (302). Добавлен
отдельный тест на редирект гостя. Все 21 тест проекта проходят.
---
 app/tests.py | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/app/tests.py b/app/tests.py
index d793bb2..801fb09 100644
--- a/app/tests.py
+++ b/app/tests.py
@@ -30,7 +30,7 @@ class SiteTests(TestCase):
         response = self.client.get(reverse('search'), {'q': 'барсик'})
         self.assertEqual(response.context['page_obj'].paginator.count, 1)
         empty = self.client.get(reverse('search'), {'q': 'нет такого'})
-        self.assertContains(empty, 'ничего не найдено')
+        self.assertContains(empty, 'Ничего не найдено')
 
     def test_profile_requires_login(self):
         response = self.client.get(reverse('profile'))
@@ -53,5 +53,10 @@ class SiteTests(TestCase):
         self.assertContains(response, 'field__error')
 
     def test_static_pages(self):
-        for name in ('about', 'donate', 'staff', 'login', 'register'):
+        for name in ('about', 'donate', 'login', 'register'):
             self.assertEqual(self.client.get(reverse(name)).status_code, 200)
+
+    def test_staff_page_requires_login(self):
+        response = self.client.get(reverse('staff'))
+        self.assertEqual(response.status_code, 302)
+        self.assertIn(reverse('login'), response['Location'])
