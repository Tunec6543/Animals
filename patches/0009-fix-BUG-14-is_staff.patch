Гостям и обычным пользователям пункт меню скрыт; сам раздел по-прежнему защищён staff_required.
---
 app/templates/base.html |  2 ++
 app/test_defects.py     | 11 +++++++++++
 2 files changed, 13 insertions(+)

diff --git a/app/templates/base.html b/app/templates/base.html
index 7e42a07..6bbaff5 100644
--- a/app/templates/base.html
+++ b/app/templates/base.html
@@ -41,7 +41,9 @@
                 {% endif %}
                 <li><a class="main-nav__link{% if current == 'about' %} is-active{% endif %}" href="{% url 'about' %}"{% if current == 'about' %} aria-current="page"{% endif %}>О нас</a></li>
                 <li><a class="main-nav__link{% if current == 'donate' %} is-active{% endif %}" href="{% url 'donate' %}"{% if current == 'donate' %} aria-current="page"{% endif %}>Поддержать</a></li>
+                {% if user.is_staff %}
                 <li><a class="main-nav__link{% if current == 'staff' %} is-active{% endif %}" href="{% url 'staff' %}"{% if current == 'staff' %} aria-current="page"{% endif %}>Сотрудникам</a></li>
+                {% endif %}
             </ul>
         </nav>
     </header>
diff --git a/app/test_defects.py b/app/test_defects.py
index 66c917c..b1e5f4a 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -150,3 +150,14 @@ class Bug12CancelButtonTests(TestCase):
         self.assertContains(response, 'href="%s"' % reverse('profile'))
         user.refresh_from_db()
         self.assertEqual(user.last_name, 'Петрова')
+
+
+class Bug14StaffLinkTests(TestCase):
+    """BUG-14: ссылка «Сотрудникам» видна только сотрудникам."""
+
+    def test_visibility(self):
+        self.assertNotContains(self.client.get(reverse('index')), 'Сотрудникам')
+        self.client.force_login(User.objects.create_user('anna', 'a@e.com', 'Test#12345'))
+        self.assertNotContains(self.client.get(reverse('index')), 'Сотрудникам')
+        self.client.force_login(User.objects.create_user('staff', 's@e.com', 'Test#12345', is_staff=True))
+        self.assertContains(self.client.get(reverse('index')), 'Сотрудникам')
