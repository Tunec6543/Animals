Сохранение заявки обёрнуто в transaction.atomic; IntegrityError от уникального
ограничения (пользователь, питомец) обрабатывается как «заявка уже подана».
---
 app/test_defects.py | 15 +++++++++++++++
 app/views.py        |  9 ++++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/app/test_defects.py b/app/test_defects.py
index a20d74f..66869aa 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -39,3 +39,18 @@ class Bug01ReservationTests(TestCase):
         self.client.post(reverse('staff_application', args=[self.app.pk]), {'action': 'reject'})
         self.pet.refresh_from_db()
         self.assertEqual(self.pet.status, 'available')
+
+
+class Bug02DoubleSubmitTests(TestCase):
+    """BUG-02: гонка при двойной отправке формы не должна давать ошибку 500."""
+
+    def test_integrity_error_on_save_is_handled(self):
+        from unittest import mock
+
+        pet = Pet.objects.create(name='Мурка', species='cat', age=1, gender='female')
+        user = User.objects.create_user('anna', 'a@e.com', 'Test#12345')
+        self.client.force_login(user)
+        with mock.patch.object(AdoptionApplication, 'save', side_effect=__import__('django').db.IntegrityError):
+            response = self.client.post(reverse('adopt', args=[pet.pk]), FORM)
+        self.assertEqual(response.status_code, 302)
+        self.assertEqual(AdoptionApplication.objects.count(), 0)
diff --git a/app/views.py b/app/views.py
index 32859bb..1bf81b1 100644
--- a/app/views.py
+++ b/app/views.py
@@ -5,6 +5,7 @@ from functools import wraps
 from django.contrib import messages
 from django.contrib.auth import login, logout
 from django.contrib.auth.decorators import login_required
+from django.db import IntegrityError, transaction
 from django.core.mail import send_mail
 from django.core.paginator import Paginator
 from django.db.models import Avg, Q, Sum
@@ -152,7 +153,13 @@ def adopt(request, pk):
         application = form.save(commit=False)
         application.user = request.user
         application.pet = pet
-        application.save()
+        try:
+            with transaction.atomic():
+                application.save()
+        except IntegrityError:
+            # BUG-02: двойная отправка формы — вторая заявка нарушает уникальность (пользователь, питомец)
+            messages.info(request, "Вы уже подавали заявку на этого питомца.")
+            return redirect("profile")
         logger.info(
             "Заявка на усыновление: пользователь=%s, питомец=%s",
             request.user.username,
