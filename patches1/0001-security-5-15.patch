+class StyledFormMixin:
+    def _style_fields(self):
+        for field in self.fields.values():
+            css = 'field__input'
+            if isinstance(field.widget, forms.Textarea):
+                css += ' field__input--area'
+            field.widget.attrs['class'] = css
+
+
+LOGIN_MAX_ATTEMPTS = 5
+LOGIN_LOCK_SECONDS = 15 * 60
+
+
+class LoginForm(StyledFormMixin, AuthenticationForm):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.fields['username'].label = 'Логин'
+        self._style_fields()
+
+    def _fail_key(self, username):
+        ip = self.request.META.get('REMOTE_ADDR', '') if self.request else ''
+        return f'login-fail:{ip}:{(username or "").lower()}'
+
+    def clean(self):
+        username = self.cleaned_data.get('username')
+        key = self._fail_key(username)
+        if cache.get(key, 0) >= LOGIN_MAX_ATTEMPTS:
+            logger.warning('Вход заблокирован после серии неудачных попыток: логин=%s', username)
+            raise forms.ValidationError(
+                'Слишком много неудачных попыток входа. Повторите через 15 минут.', code='locked'
+            )
+        try:
+            result = super().clean()
+        except forms.ValidationError:
+            logger.warning('Неудачная попытка входа: логин=%s', username)
+            cache.add(key, 0, LOGIN_LOCK_SECONDS)
+            try:
+                cache.incr(key)
+            except ValueError:
+                cache.set(key, 1, LOGIN_LOCK_SECONDS)
+            raise
+        cache.delete(key)
+        return result
+
+
+class RegisterForm(StyledFormMixin, forms.ModelForm):
+    password = forms.CharField(label='Пароль', min_length=8, widget=forms.PasswordInput)
+
+    class Meta:
+        model = User
+        fields = ('username', 'email')
+        labels = {'username': 'Логин', 'email': 'Email'}
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.fields['email'].required = True
+        self._style_fields()
+
+    def clean_email(self):
+        email = self.cleaned_data['email']
+        if User.objects.filter(email__iexact=email).exists():
+            raise forms.ValidationError('Пользователь с таким email уже зарегистрирован.')
+        return email
+
+    def clean_password(self):
+        password = self.cleaned_data['password']
+        validate_password(password)
+        return password
+
+    def save(self, commit=True):
+        user = super().save(commit=False)
+        user.set_password(self.cleaned_data['password'])
+        if commit:
+            user.save()
+        return user
