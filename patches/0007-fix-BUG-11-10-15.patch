Значения «----------», «((((((((((» и из одних пробелов больше не сохраняются в профиле;
формат 8(900)000-00-00 по-прежнему принимается.
---
 app/forms.py        | 13 ++++++++++---
 app/test_defects.py | 15 +++++++++++++++
 2 files changed, 25 insertions(+), 3 deletions(-)

diff --git a/app/forms.py b/app/forms.py
index 3865362..e32bc48 100644
--- a/app/forms.py
+++ b/app/forms.py
@@ -14,9 +14,16 @@ User = get_user_model()
 
 logger = logging.getLogger(__name__)
 
-phone_validator = RegexValidator(
-    r'^\+?[\d\s()-]{10,18}$', 'Введите телефон в формате +7 900 000-00-00.'
-)
+PHONE_MESSAGE = 'Введите телефон в формате +7 900 000-00-00.'
+_phone_chars = RegexValidator(r'^\+?[\d\s()-]{10,18}$', PHONE_MESSAGE)
+
+
+def phone_validator(value):
+    # BUG-11: помимо допустимых символов в номере должно быть от 10 до 15 цифр
+    _phone_chars(value)
+    digits = sum(ch.isdigit() for ch in value)
+    if not 10 <= digits <= 15:
+        raise forms.ValidationError(PHONE_MESSAGE)
 
 
 class StyledFormMixin:
diff --git a/app/test_defects.py b/app/test_defects.py
index 06c013d..54dca0c 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -122,3 +122,18 @@ class Bug10PhotoSizeTests(TestCase):
         validate_photo_size(ContentFile(b'x' * (5 * 1024 * 1024), name='ok.jpg'))
         with self.assertRaises(ValidationError):
             validate_photo_size(ContentFile(b'x' * (5 * 1024 * 1024 + 1), name='big.jpg'))
+
+
+class Bug11PhoneValidatorTests(TestCase):
+    """BUG-11: телефон без цифр не принимается, форматы с цифрами — принимаются."""
+
+    def test_validator(self):
+        from django.core.exceptions import ValidationError
+        from .forms import phone_validator
+
+        for bad in ('----------', '          ', '((((((((((', '12-34', 'abc'):
+            with self.subTest(value=bad), self.assertRaises(ValidationError):
+                phone_validator(bad)
+        for good in ('+7 900 111-22-33', '8(900)000-00-00', '89001112233'):
+            with self.subTest(value=good):
+                phone_validator(good)
