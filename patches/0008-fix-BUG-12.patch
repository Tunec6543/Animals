Шаблон form_page.html выводит ссылку «Отмена», если во view передан cancel_url;
для профиля она ведёт на страницу профиля без сохранения изменений.
---
 app/templates/form_page.html |  1 +
 app/test_defects.py          | 13 +++++++++++++
 app/views.py                 |  2 ++
 3 files changed, 16 insertions(+)

diff --git a/app/templates/form_page.html b/app/templates/form_page.html
index aafbd9e..ad3bfb1 100644
--- a/app/templates/form_page.html
+++ b/app/templates/form_page.html
@@ -9,6 +9,7 @@
         {% csrf_token %}
         {% include '_form_fields.html' %}
         <button class="btn btn--black" type="submit">{{ submit }}</button>
+        {% if cancel_url %}<a class="btn btn--green" href="{{ cancel_url }}">Отмена</a>{% endif %}
     </form>
 </section>
 {% endblock %}
diff --git a/app/test_defects.py b/app/test_defects.py
index 54dca0c..66c917c 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -137,3 +137,16 @@ class Bug11PhoneValidatorTests(TestCase):
         for good in ('+7 900 111-22-33', '8(900)000-00-00', '89001112233'):
             with self.subTest(value=good):
                 phone_validator(good)
+
+
+class Bug12CancelButtonTests(TestCase):
+    """BUG-12: на форме редактирования профиля есть «Отмена», ведущая в профиль без изменений."""
+
+    def test_cancel_link(self):
+        user = User.objects.create_user('anna', 'a@e.com', 'Test#12345', last_name='Петрова')
+        self.client.force_login(user)
+        response = self.client.get(reverse('profile_edit'))
+        self.assertContains(response, 'Отмена')
+        self.assertContains(response, 'href="%s"' % reverse('profile'))
+        user.refresh_from_db()
+        self.assertEqual(user.last_name, 'Петрова')
diff --git a/app/views.py b/app/views.py
index efcfbc6..a6626f1 100644
--- a/app/views.py
+++ b/app/views.py
@@ -12,6 +12,7 @@ from django.db.models import Avg, Q, Sum
 from django.http import JsonResponse
 from django.shortcuts import get_object_or_404, redirect, render
 from django.template.loader import render_to_string
+from django.urls import reverse
 from django.utils import timezone
 from django.views.decorators.http import require_POST
 
@@ -232,6 +233,7 @@ def profile_edit(request):
             "form": form,
             "title": "Редактирование профиля",
             "submit": "Сохранить",
+            "cancel_url": reverse("profile"),
         },
     )
 
