Поле amount в DonateForm заменено на IntegerField: дробные значения (150.5) отклоняются,
сообщение для некорректного ввода стало понятным («Введите целое число рублей»).
---
 app/forms.py        |  5 +++--
 app/test_defects.py | 22 ++++++++++++++++++++++
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/app/forms.py b/app/forms.py
index 09a1ba3..3865362 100644
--- a/app/forms.py
+++ b/app/forms.py
@@ -141,8 +141,9 @@ class DonateForm(StyledFormMixin, forms.ModelForm):
     pet = forms.ModelChoiceField(
         label='Питомец', queryset=Pet.objects.exclude(status='adopted'), empty_label='Выберите питомца',
     )
-    amount = forms.DecimalField(
-        label='Сумма взноса, ₽', min_value=50, max_value=100000, max_digits=10, decimal_places=2,
+    amount = forms.IntegerField(
+        label='Сумма взноса, ₽', min_value=50, max_value=100000,
+        error_messages={'invalid': 'Введите целое число рублей, например 500.'},
         widget=forms.NumberInput(attrs={'min': 50, 'max': 100000, 'step': 1, 'placeholder': 'Сумма ₽...'}),
     )
     payment_type = forms.ChoiceField(
diff --git a/app/test_defects.py b/app/test_defects.py
index c098119..081c483 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -87,3 +87,25 @@ class Bug04ProfileEmailTests(TestCase):
 
     def test_own_email_accepted(self):
         self.assertEqual(self._post('anna@example.com').status_code, 302)
+
+
+class Bug06IntegerAmountTests(TestCase):
+    """BUG-06: сумма пожертвования — только целое число рублей."""
+
+    def setUp(self):
+        self.pet = Pet.objects.create(name='Рекс', species='dog', age=4, gender='male')
+        self.client.force_login(User.objects.create_user('anna', 'a@e.com', 'Test#12345'))
+
+    def _donate(self, amount):
+        from .models import SponsorshipPayment
+        before = SponsorshipPayment.objects.count()
+        self.client.post(reverse('donate'), {'pet': self.pet.pk, 'amount': amount, 'payment_type': 'sbp', 'comment': ''})
+        return SponsorshipPayment.objects.count() - before
+
+    def test_fractional_rejected(self):
+        for value in ('150.5', '150,5', 'abc', '<b>1</b>'):
+            with self.subTest(value=value):
+                self.assertEqual(self._donate(value), 0)
+
+    def test_integer_accepted(self):
+        self.assertEqual(self._donate('500'), 1)
