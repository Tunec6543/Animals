Принимаются только числа до 18 цифр и не более 200 идентификаторов (OverflowError в SQLite,
ValueError при int() от строки длиннее 4300 цифр).
---
 app/test_defects.py | 10 ++++++++++
 app/views.py        |  7 ++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/app/test_defects.py b/app/test_defects.py
index 66869aa..c9876f1 100644
--- a/app/test_defects.py
+++ b/app/test_defects.py
@@ -54,3 +54,13 @@ class Bug02DoubleSubmitTests(TestCase):
             response = self.client.post(reverse('adopt', args=[pet.pk]), FORM)
         self.assertEqual(response.status_code, 302)
         self.assertEqual(AdoptionApplication.objects.count(), 0)
+
+
+class Bug03IdsOverflowTests(TestCase):
+    """BUG-03: гигантское значение ids не должно приводить к ошибке 500."""
+
+    def test_huge_ids_do_not_crash(self):
+        Pet.objects.create(name='Рекс', species='dog', age=4, gender='male')
+        for url in ('/api/pets/?ids=99999999999999999999', '/?ids=' + '9' * 5000, '/search/?q=a&ids=99999999999999999999999999'):
+            with self.subTest(url=url):
+                self.assertEqual(self.client.get(url).status_code, 200)
diff --git a/app/views.py b/app/views.py
index 1bf81b1..efcfbc6 100644
--- a/app/views.py
+++ b/app/views.py
@@ -48,7 +48,12 @@ def _filter_pets(request):
     if species in dict(Pet.SPECIES_CHOICES):
         pets = pets.filter(species=species)
     if "ids" in request.GET:
-        ids = [int(i) for i in request.GET["ids"].split(",") if i.isdigit()]
+        # BUG-03: ограничиваем длину числа и количество идентификаторов, иначе SQLite даёт OverflowError (500)
+        ids = [
+            int(i)
+            for i in request.GET["ids"].split(",")[:200]
+            if i.isdigit() and len(i) <= 18
+        ]
         pets = pets.filter(pk__in=ids)
     if q:
         # SQLite сравнивает кириллицу с учётом регистра, поэтому пробуем разные варианты написания
